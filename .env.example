DATABASE_URL="file:./dev.db"
ANTHROPIC_API_KEY="sk-ant-..."

# When true (the default), every LLM call in the app is routed through
# deterministic stubs instead of the Anthropic API — no API key needed to
# run the full pipeline, seed the DB, or pass the eval harness. Set to
# "false" once a real ANTHROPIC_API_KEY is set above.
GATEKEEPER_USE_STUB_LLM="true"

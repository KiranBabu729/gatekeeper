DATABASE_URL="file:./dev.db"
ANTHROPIC_API_KEY="sk-ant-..."

# When true (the default), every LLM call in the app is routed through
# deterministic stubs instead of the Anthropic API — no API key needed to
# run the full pipeline, seed the DB, or pass the eval harness. Set to
# "false" once a real ANTHROPIC_API_KEY is set above.
GATEKEEPER_USE_STUB_LLM="true"

# Jira import through Keyhouse (optional). Create an application in Keyhouse
# with access mode "proxy", add GATEKEEPER_BASE_URL + "/" to its return URLs,
# and create a test SDK key for it. Leave these unset to hide Jira import.
KEYHOUSE_BASE_URL="http://localhost:3000"
KEYHOUSE_SECRET_KEY=""
GATEKEEPER_BASE_URL="http://localhost:3100"
